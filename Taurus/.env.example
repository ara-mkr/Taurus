# Copy to .env (never committed) or paste these on the Connections page instead.
# Values here win over values saved from the app. Everything else lives in ~/.taurus.

# Where Taurus listens. 0.0.0.0 lets your phone reach it on the same Wi-Fi (pairing key required).
TAURUS_HOST=127.0.0.1
TAURUS_PORT=8787
# Set when Taurus sits behind HTTPS (for example `tailscale serve`), so OAuth redirects use it.
# TAURUS_PUBLIC_URL=https://your-mac.tailnet.ts.net

# Taurus's hosted sign-in service (default shown). Providers it has keys for are one click;
# the client ID/secret lines below are only needed to use your own apps instead. Empty turns it off.
# TAURUS_BROKER_URL=https://oxbot-signin.oxbot-signin.workers.dev

# One OAuth client each. Register this redirect URL with every provider:
#   http://localhost:8787/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Tokens
SLACK_USER_TOKEN=
GITHUB_TOKEN=
LINEAR_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
SHEET_ID=
SHEET_RANGE=Taurus!A1:C12
STRIPE_KEY=
HUBSPOT_TOKEN=
ICS_URLS=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Ringing
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MY_PHONE=
