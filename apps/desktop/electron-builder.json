{
  "appId": "local.taurus.desktop",
  "productName": "Taurus",
  "copyright": "Personal build for Akhil. Not for distribution.",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "!dist/**/*.map"
  ],
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "web"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "dist/taurus-hands",
    "dist/TaurusNotch",
    "dist/libTaurusNowPlaying.dylib",
    "**/node_modules/onnxruntime-node/**",
    "**/node_modules/onnxruntime-common/**",
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "publish": null,
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "icon": "assets/icon.icns",
    "category": "public.app-category.productivity",
    "identity": "-",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "notarize": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Taurus asks for the microphone only when you tap Talk.",
      "NSCameraUsageDescription": "Taurus uses the camera only while Look is open, and sends one frame to your AI when you tap Send.",
      "NSCalendarsFullAccessUsageDescription": "Taurus reads today's and tomorrow's events to show your schedule and ring before meetings. It never changes your calendars.",
      "NSCalendarsUsageDescription": "Taurus reads today's and tomorrow's events to show your schedule and ring before meetings. It never changes your calendars."
    },
    "artifactName": "Taurus-${version}-AppleSilicon.${ext}"
  },
  "dmg": {
    "writeUpdateInfo": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "differentialPackage": false,
    "artifactName": "Taurus-Setup-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "assets/icon.png",
    "category": "Office",
    "maintainer": "Taurus <taurus@localhost>",
    "synopsis": "Local chief-of-staff dashboard that rings when it matters."
  },
  "appImage": {
    "artifactName": "Taurus-${version}-${arch}.${ext}"
  },
  "deb": {
    "artifactName": "taurus_${version}_${arch}.${ext}"
  }
}
