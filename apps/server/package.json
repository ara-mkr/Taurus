{
  "name": "taurus-server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Taurus local server: connectors, dashboard, ask, and phone ringing. Runs on your machine only.",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "playwright-core": "1.64.1",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
